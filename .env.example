# 复制为项目根目录 .env 后修改（勿提交 .env）
# 启动 API：python3 -m uvicorn api.main:app --host 127.0.0.1 --port 8000 --app-dir apps

PYTHONPATH=packages:apps
JOB_RUN_INLINE=1
JWT_SECRET=local-dev-jwt-secret-32chars-min
APP_BASE_URL=http://localhost:3000

# 本地 mock 解析（默认，无需 Docker）：
# MSE_ALLOW_MOCK_FALLBACK=1
# PDF_CONVERTER_MODE=mock

# 真实论文 PDF 测试（需 Docker + 镜像，见 scripts/download_real_pdf_samples.sh）：
# PDF_CONVERTER_MODE=docker
# MSE_ALLOW_MOCK_FALLBACK=0
# MAKER_IMAGE=fudan-pager-maker
# MINERU_IMAGE=fudan-pager-mineru
# MINERU_BACKEND=pipeline
# MINERU_METHOD=txt
# MINERU_START_PAGE=0
# MINERU_END_PAGE=7
# MINERU_PDF_RENDER_THREADS=1
# MINERU_PROCESSING_WINDOW_SIZE=8
# MINERU_FORMULA_ENABLE=false
# MINERU_TABLE_ENABLE=false
# MINERU_DOCKER_SHM_SIZE=2g
# MINERU_TIMEOUT_SECONDS=1800
# MINERU_CACHE_VOLUME=fudan-pager-mineru-cache
# MINERU_CACHE_DIR= # 可选：显式宿主目录缓存；本地 macOS 推荐使用上面的 Docker volume
# MINERU_TEST_PDF=samples/real_pdfs/arxiv_attention_is_all_you_need.pdf

NOTIFIER=console

# --- LLM（DeepSeek，可选）---
# LLM_PROVIDER=deepseek
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# --- SMTP 邮件（NOTIFIER=smtp 时生效）---
# NOTIFIER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_USE_TLS=1
# SMTP_TEST_STU=your-test-recipient@example.com

# --- 飞书/企业微信 webhook（NOTIFIER=webhook 时生效）---
# NOTIFIER=webhook
# WEBHOOK_KIND=feishu # feishu | wecom
# WEBHOOK_URL=https://example.invalid/webhook
# WEBHOOK_TIMEOUT_SECONDS=15

# --- 修订截止提醒 cron ---
# MSE_REVISION_DUE_DAYS=7
# MSE_REVISION_REMINDER_WINDOW_HOURS=24
# MSE_REVISION_REMINDER_DRY_RUN=0

# --- 本地准生产验收公开 PDF（可选；默认自动下载公开 CS 硕士论文）---
# MINERU_TEST_PDF=samples/real_pdfs/public_cs_master_thesis.pdf
# MSE_PUBLIC_THESIS_PAGE_URL=https://digitalcommons.dartmouth.edu/masters_theses/24/

