# 复制为 deploy/.env.prod 并修改密钥（勿提交 .env.prod）
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
CORS_ORIGINS=https://pager.tyrion.space,http://localhost:3000
PDF_CONVERTER_MODE=mock

# ==========================================
# Agent 流水线与模型配置
# ==========================================
# 代理模式: rules (仅规则), agents (纯Agent), hybrid (合并)
AGENT_MODE=hybrid
# 学术润色功能开关
POLISH_ENABLED=true
# 大模型鉴权
LLM_API_KEY=
LLM_BASE_MODEL=qwen-plus
# 微调模型路由开关 (设为true时会根据任务调用特定LoRA)
FT_ENABLED=false
FT_ADAPTER_TYPO=
FT_ADAPTER_POLISH=
FT_ADAPTER_LOGIC=
