# 复制为 deploy/.env.prod 并修改密钥（勿提交 .env.prod）

# --- 基础 ---
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
CORS_ORIGINS=https://pager.tyrion.space,http://localhost:3000
APP_BASE_URL=https://pager.tyrion.space

# --- MSE 数据库（容器内路径，四个斜杠 = 绝对路径）---
MSE_DATABASE_URL=sqlite:////app/data/mse.db

# --- PDF / MinerU（生产必须 docker + 禁用 mock）---
PDF_CONVERTER_MODE=docker
MSE_ALLOW_MOCK_FALLBACK=0
MINERU_IMAGE=fudan-pager-mineru
MAKER_IMAGE=fudan-pager-maker
MINERU_MAX_RETRIES=2

# --- MSE 邀请链接签名（可与 JWT_SECRET 相同，建议独立）---
MSE_INVITE_SECRET=
MSE_INVITE_TTL_DAYS=7

# --- 邮件通知（console | smtp）---
NOTIFIER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=1

# --- LLM（DeepSeek，可选；未配置时规则层仍运行）---
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_MODEL_REASONING=deepseek-reasoner

# --- Worker 内联（生产留空，使用 arq + redis）---
# JOB_RUN_INLINE=
