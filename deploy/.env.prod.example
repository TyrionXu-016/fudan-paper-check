# 复制为 deploy/.env.prod 并修改密钥（勿提交 .env.prod）

# --- 基础 ---
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
CORS_ORIGINS=https://mse.paper.tyrion.space,https://api-mse.tyrion.space,http://api-mse.tyrion.space,http://localhost:3000
APP_BASE_URL=https://mse.paper.tyrion.space

# --- MSE 数据库（容器内路径，四个斜杠 = 绝对路径）---
MSE_DATABASE_URL=sqlite:////app/data/mse.db

# --- PDF / MinerU（生产必须 docker + 禁用 mock）---
PDF_CONVERTER_MODE=docker
MSE_ALLOW_MOCK_FALLBACK=0
MINERU_IMAGE=fudan-pager-mse-mineru
MAKER_IMAGE=fudan-pager-mse-maker
MINERU_BACKEND=pipeline
MINERU_METHOD=auto
MINERU_MAX_RETRIES=2
MINERU_TIMEOUT_SECONDS=1800
MINERU_CACHE_VOLUME=fudan-pager-mse-mineru-cache
# MINERU_CACHE_DIR=/app/data/mineru-cache
# 本地准生产验收可设置页码窗口降低本机 OCR 资源波动；生产建议留空处理全文
# MINERU_START_PAGE=0
# MINERU_END_PAGE=7
# MINERU_PDF_RENDER_THREADS=1
# MINERU_PROCESSING_WINDOW_SIZE=8
# MINERU_FORMULA_ENABLE=false
# MINERU_TABLE_ENABLE=false
# MINERU_DOCKER_SHM_SIZE=2g

# --- MSE 邀请链接签名（可与 JWT_SECRET 相同，建议独立）---
MSE_INVITE_SECRET=
MSE_INVITE_TTL_DAYS=7

# --- 邮件通知（console | smtp）---
NOTIFIER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=1
# 本地准生产验收收件人；生产部署可留空
SMTP_TEST_STU=

# --- Webhook 通知（替代 SMTP，可用于飞书/企业微信）---
# NOTIFIER=webhook
# WEBHOOK_KIND=feishu
# WEBHOOK_URL=
# WEBHOOK_TIMEOUT_SECONDS=15

# --- 修订截止提醒（cron/systemd timer 调 scripts/mse_revision_reminders.py）---
MSE_REVISION_DUE_DAYS=7
MSE_REVISION_REMINDER_WINDOW_HOURS=24
MSE_REVISION_REMINDER_DRY_RUN=0

# --- LLM（DeepSeek，可选；未配置时规则层仍运行）---
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_MODEL_REASONING=deepseek-reasoner

# --- Worker 内联（生产留空，使用 arq + redis）---
# JOB_RUN_INLINE=
